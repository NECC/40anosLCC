generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())  // schema de teste
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}

model Activity {
  id          String       @id @default(uuid())
  title       String
  speakers    String[]
  description String
  startDate   DateTime
  endDate     DateTime
  type        ActivityType
}

enum ActivityType {
  WORKSHOP
  TALK
}
